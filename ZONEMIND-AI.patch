diff --git a/src/zonemind/knowledge/schema.py b/src/zonemind/knowledge/schema.py
new file mode 100644
index 0000000..bf15102
--- /dev/null
+++ b/src/zonemind/knowledge/schema.py
@@ -0,0 +1,55 @@
+"""Typed records for the governed knowledge base.
+
+A ``Document`` is one Markdown file. Its front matter yields ``Directive`` records for
+the deterministic reasoner and ``Constraint`` records for the verifier, and its prose
+is split into ``Chunk`` records for retrieval.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+
+@dataclass
+class Directive:
+    id: str
+    doc_id: str
+    priority: int
+    label: str
+    when: str
+    set: dict[str, str] = field(default_factory=dict)
+    lockout: bool = False
+
+
+@dataclass
+class Constraint:
+    """A hard limit. ``kind`` is one of bound, gap, rate or flag."""
+
+    id: str
+    doc_id: str
+    kind: str
+    reason: str = ""
+    when: str | None = None
+    var: str | None = None
+    min: float | None = None
+    max: float | None = None
+    max_delta: float | None = None
+    min_gap: float | None = None
+
+
+@dataclass
+class Chunk:
+    id: str
+    doc_id: str
+    heading: str
+    text: str
+
+
+@dataclass
